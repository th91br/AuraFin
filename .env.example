# ==============================================================================
# AuraFin — Environment Variables Template
# ==============================================================================
# IMPORTANTE: Nunca commite valores reais ou secrets de produção neste arquivo.
# Configure as variáveis abaixo no Vercel e nos ambientes locais correspondentes.

# GEMINI_API_KEY: Required for Aura Assistant AI capabilities.
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: Public URL of the web application.
# Development: http://localhost:3000
# Staging:     https://staging.aurafin.app (or vercel preview domain)
# Production:  https://aurafin.app
APP_URL="http://localhost:3000"

# ==============================================================================
# SUPABASE CLIENT CONFIGURATION (Public Variables - Client Bundle Safe)
# ==============================================================================
# Development (Local Supabase CLI):
# VITE_SUPABASE_URL="http://127.0.0.1:54321"
# VITE_SUPABASE_ANON_KEY="your-local-anon-key"

# Staging / Production:
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# ==============================================================================
# OBSERVABILITY & TELEMETRY CONFIGURATION
# ==============================================================================
# VITE_APP_ENV: Current environment ('development' | 'staging' | 'production')
VITE_APP_ENV="development"

# VITE_RELEASE_SHA: Git commit SHA injected by CI/CD pipeline
VITE_RELEASE_SHA="local-dev"

# VITE_ERROR_TRACKING_ENABLED: Enable/disable remote error tracker ('true' | 'false')
VITE_ERROR_TRACKING_ENABLED="false"

# VITE_ERROR_TRACKING_DSN: External error tracking endpoint (e.g. Sentry / OpenTelemetry)
VITE_ERROR_TRACKING_DSN=""

# ==============================================================================
# CI/CD SECRETS (Configure exclusively in GitHub Secrets / Environments)
# ==============================================================================
# SUPABASE_ACCESS_TOKEN: Personal access token generated in Supabase Dashboard (Account -> Access Tokens)
# SUPABASE_PROJECT_ID_STAGING: Reference ID of the Staging Supabase project
# SUPABASE_PROJECT_ID_PRODUCTION: Reference ID of the Production Supabase project
# SUPABASE_DB_PASSWORD_STAGING: Database password for Staging PostgreSQL
# SUPABASE_DB_PASSWORD_PRODUCTION: Database password for Production PostgreSQL
